[gd_scene load_steps=2 format=3 uid="uid://frontier_ui"]

[ext_resource type="Script" path="res://scripts/UIController.gd" id="1_ui_script"]

[node name="UI" type="CanvasLayer"]
script = ExtResource("1_ui_script")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="HudPanel" type="PanelContainer" parent="Root"]
layout_mode = 0
offset_left = 16.0
offset_top = 16.0
offset_right = 400.0
offset_bottom = 340.0

