theme_override_font_sizes/font_size = 18
text = "Frontier Town 0.5"

[node name="RoleLabel" type="Label" parent="Root/HudPanel/HudMargin/HudVBox"]
layout_mode = 2
text = "Role: Aucun"

[node name="MissionLabel" type="Label" parent="Root/HudPanel/HudMargin/HudVBox"]
