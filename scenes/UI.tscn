[node name="BountyLabel" type="Label" parent="Root/HudPanel/HudMargin/HudVBox"]
layout_mode = 2
text = "Prime: $0"

[node name="ZoneLabel" type="Label" parent="Root/HudPanel/HudMargin/HudVBox"]
layout_mode = 2
