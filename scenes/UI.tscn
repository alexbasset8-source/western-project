[node name="DayLabel" type="Label" parent="Root/HudPanel/HudMargin/HudVBox"]
layout_mode = 2
text = "Jour: 1"

[node name="ActionLabel" type="Label" parent="Root/HudPanel/HudMargin/HudVBox"]
