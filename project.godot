; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Frontier Town"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SaveManager="*res://scripts/SaveManager.gd"
InjuryManager="*res://scripts/InjuryManager.gd"
PrisonManager="*res://scripts/PrisonManager.gd"
GameState="*res://scripts/GameState.gd"
RoleManager="*res://scripts/RoleManager.gd"
EventManager="*res://scripts/EventManager.gd"
ReputationManager="*res://scripts/ReputationManager.gd"
TownActions="*res://scripts/TownActions.gd"
PlayerActionManager="*res://scripts/PlayerActionManager.gd"
ZoneManager="*res://scripts/ZoneManager.gd"
MissionManager="*res://scripts/MissionManager.gd"
HealManager="*res://scripts/HealManager.gd"
NpcSpawner="*res://scripts/NpcSpawner.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
